# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security — set a long random string in production
JWT_SECRET=replace-with-a-long-random-secret

# Database
# Leave as default to use ./appointments.db, or use :memory: for tests
DB_PATH=

# SMTP (optional — used for email notifications and reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MedCare <no-reply@medcare.local>
